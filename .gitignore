# Obsidian session and cache state — regenerated by Obsidian, not vault content.
# Note: a workspace.json committed in the initial snapshot stays tracked
# until it is deliberately removed; this file only prevents new copies
# and other session files from being added.
**/.obsidian/workspace*.json
**/.obsidian/cache/
**/.obsidian/workspace-mobile.json

# OS artefacts
.DS_Store
Thumbs.db

# Editor and temporary files
*.tmp
*.swp
*~

# Secrets — the vault must never contain secret values.
# This is a backstop only, not permission to add secrets here.
.env
.env.*
*.pem
*.key

# Generated build artefacts, if a skill ever produces them locally.
# Vault notes themselves are Markdown and are not ignored.
node_modules/
dist/
